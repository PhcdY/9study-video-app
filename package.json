{
  "name": "9study-video",
  "productName": "9Study Video",
  "version": "0.1.3",
  "description": "App Windows giup cong tac vien lam video giai thich ban chat bang bo cong cu 9Study",
  "main": "./out/main/index.js",
  "author": "9Study",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "fetch-runtimes": "node scripts/fetch-runtimes.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "gen:codex": "codex app-server generate-ts --out src/main/services/codex/protocol",
    "postinstall": "install-electron && electron-builder install-app-deps && npm run gen:codex",
    "build:unpack": "npm run fetch-runtimes && npm run build && electron-builder --dir",
    "build:win": "npm run fetch-runtimes && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@openai/codex": "0.171.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dugite": "3.3.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "dugite@3.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
